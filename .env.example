# Firebase 웹 앱 설정값
#
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성 에서 확인합니다.
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
#
# 이 값들은 클라이언트 번들에 그대로 포함되며 비밀이 아닙니다.
# 데이터 접근 통제는 firestore.rules 가 담당합니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 관리자 페이지로 들어가는 숨은 통로를 열려면 눌러야 하는 횟수 (2 이상의 정수)
#
# 비워 두면 통로가 닫힌 채로 동작합니다. 관리자는 주소를 직접 쳐서 들어갑니다.
# 값을 소스에 적지 않는 이유는 저장소가 공개돼 있어 커밋 이력에 남기 때문입니다.
# 위 설명대로 이 값 역시 번들에 포함되므로, 배포된 파일을 뜯어보는 사람에게는 감춰지지 않습니다.
VITE_ADMIN_SHORTCUT_TAP_COUNT=
