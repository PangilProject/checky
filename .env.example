# Firebase 웹 앱 설정값
#
# Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성 에서 확인합니다.
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요.
#
# 이 값들은 클라이언트 번들에 그대로 포함되며 비밀이 아닙니다.
# 데이터 접근 통제는 firestore.rules 가 담당합니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
