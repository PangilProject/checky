rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 관리자 여부는 users/{uid}.isAdmin 으로 판단한다.
    // 이 필드는 아래 users 규칙에서 클라이언트가 스스로 바꿀 수 없도록 막는다.
    // 없는 필드를 기본값 false 로 읽어, 문서에 isAdmin 이 없어도 안전하게 거짓이 된다.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isAdmin', false) == true;
    }

    // users 문서에 둘 수 있는 필드. 닫힌 집합으로 두어 모르는 필드가 섞이지 못하게 한다.
    // 프로필에 필드를 추가하려면 여기에도 함께 추가해야 한다.
    function allowedUserFields() {
      return [
        'uid', 'email', 'name', 'photoURL',
        'createdAt', 'updatedAt', 'lastLoginAt', 'lastActiveAt',
        'isAdmin'
      ];
    }

    // 시각 필드는 서버 시각으로만 남긴다.
    // 클라이언트가 임의 시각을 넣을 수 있으면 관리자 지표(가입 추이·활성 판정)를
    // 통째로 조작할 수 있고, 활성 상태를 영구히 유지하는 것도 가능해진다.
    // 값을 그대로 두는 수정은 허용해야 다른 필드만 고치는 갱신이 막히지 않는다.
    function timeFieldIsTrusted(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == request.time
        || (resource != null
            && field in resource.data
            && request.resource.data[field] == resource.data[field]);
    }

    function timeFieldsAreTrusted() {
      return timeFieldIsTrusted('createdAt')
        && timeFieldIsTrusted('updatedAt')
        && timeFieldIsTrusted('lastLoginAt')
        && timeFieldIsTrusted('lastActiveAt');
    }

    // 프로필 필드의 값 검사. 문서에 있는 필드만 본다.
    // uid 는 없으면 기본값으로 경로 uid 를 써서, uid 가 없던 옛 문서도
    // 갱신이 막히지 않게 하되 다른 uid 로 위조하는 것은 막는다.
    function userFieldsAreValid(userId) {
      let data = request.resource.data;
      return data.get('uid', userId) == userId
        && (!('name' in data)
            || (data.name is string && data.name.size() <= 100))
        && (!('email' in data)
            || data.email == null
            || (data.email is string && data.email.size() <= 320))
        && (!('photoURL' in data)
            || data.photoURL == null
            || (data.photoURL is string && data.photoURL.size() <= 2048))
        && timeFieldsAreTrusted();
    }

    // 이미 있는 필드를 지워 없애지 못하게 한다.
    // 없던 문서에는 요구하지 않아, 옛 문서도 갱신할 수 있다.
    function keepsField(field) {
      return !(field in resource.data) || (field in request.resource.data);
    }

    // 사용자 프로필
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // 최초 로그인 시 본인 문서만 생성 가능. isAdmin 자체 부여 차단.
      // 새로 만드는 문서는 모양을 온전히 강제할 수 있으므로 엄격하게 본다.
      allow create: if isOwner(userId)
        && !('isAdmin' in request.resource.data)
        && request.resource.data.keys().hasOnly(allowedUserFields())
        && request.resource.data.keys().hasAll(['uid', 'name'])
        && userFieldsAreValid(userId);

      // 본인 문서 수정 가능하나 isAdmin 값은 변경 불가 (권한 상승 차단).
      // 기존 문서에 isAdmin 이 없으면 수정 후에도 없어야 하고,
      // 있으면 값이 그대로 유지되어야 한다.
      allow update: if isOwner(userId)
        && (
          'isAdmin' in resource.data
            ? ('isAdmin' in request.resource.data
                && request.resource.data.isAdmin == resource.data.isAdmin)
            : !('isAdmin' in request.resource.data)
        )
        // 바뀐 키만 검사한다. 문서 전체를 검사하면 예전 스키마의 모르는
        // 필드가 남아 있는 문서는 건드리지도 않은 필드 때문에 갱신이 영구히
        // 막히고, 접속 기록 실패는 조용히 삼켜져 눈에 띄지도 않는다.
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(allowedUserFields())
        && keepsField('uid')
        && keepsField('name')
        && userFieldsAreValid(userId);

      allow delete: if isOwner(userId);

      // 사용자 데이터는 본인만 읽고 쓴다 (관리자도 열람 불가).
      // 컬렉션 이름을 앱이 쓰는 것으로 한정해, 자기 영역이라도 임의의
      // 저장 공간으로 쓰지 못하게 한다. 새 도메인을 추가하면 여기에도 넣는다.
      match /{subCollection}/{docId} {
        allow read, write: if isOwner(userId)
          && subCollection in [
            'tasks', 'taskLogs',
            'routines', 'routineLogs',
            'categories', 'monthlyStats'
          ];
      }
    }

    // 공지사항: 로그인 사용자는 읽기만, 작성/수정/삭제는 관리자만
    match /notices/{noticeId} {
      allow read: if isSignedIn();

      // 공지에 둘 수 있는 필드. crud.ts 가 쓰는 것과 같아야 한다.
      function allowedNoticeFields() {
        return ['title', 'content', 'pinned', 'createdAt', 'updatedAt'];
      }

      /**
       * 공지 내용 검사.
       *
       * 권한만 보면 관리자 토큰이 새는 순간 크기 제한이 사라진다. 공지는 로그인한
       * 모든 사용자가 내려받으므로, 한 문서가 커지면 그 비용이 전체에 퍼진다.
       *
       * 길이 상한은 NoticeModal.tsx 의 TITLE_MAX_LENGTH·CONTENT_MAX_LENGTH 와
       * 짝을 이룬다. 한쪽만 고치면 화면에서는 더 쓸 수 있는데 저장이 거부된다.
       *
       * 글자 내용은 검사하지 않는다. `<script>` 같은 문자열도 정상 입력으로 저장하고,
       * 화면에서 글자로만 보이도록 하는 것이 이 앱의 방침이다(출력 단계 이스케이프).
       */
      function noticeIsValid() {
        let data = request.resource.data;
        return data.keys().hasOnly(allowedNoticeFields())
          && data.keys().hasAll(['title', 'content', 'pinned'])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.content is string
          && data.content.size() <= 2000
          && data.pinned is bool
          && timeFieldsAreTrusted();
      }

      allow create: if isAdmin() && noticeIsValid();

      // 바뀐 키만 본다. 상단 고정만 전환하는 경로(setNoticePinned)는
      // pinned·updatedAt 만 보내므로, 전체를 요구하면 그 기능이 막힌다.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['title', 'content', 'pinned', 'updatedAt'])
        && noticeIsValid();

      allow delete: if isAdmin();
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
