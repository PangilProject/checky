# E2E 테스트 전용 설정 (`vite --mode e2e`)
#
# .env 의 실제 프로젝트 값을 덮어써서, 테스트가 어떤 경우에도 운영 데이터에 닿지 않게 한다.
# demo- 로 시작하는 프로젝트 ID 는 Firebase 에뮬레이터 전용이라 실제 프로젝트와 연결될 수 없다.
# 값이 비밀이 아니므로 저장소에 올린다.

VITE_FIREBASE_API_KEY=e2e-fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-checky.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-checky
VITE_FIREBASE_STORAGE_BUCKET=demo-checky.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=e2e-fake-app-id
VITE_ADMIN_SHORTCUT_TAP_COUNT=
