# 단위 테스트 전용 설정 (vitest 는 test 모드로 돌아 이 파일을 읽는다)
#
# .env 의 실제 프로젝트 값을 덮어써, 단위 테스트가 어떤 경우에도 운영 프로젝트 설정을 쓰지 않게 한다.
# .env 가 없는 CI 에서도 Firebase 초기화가 실패하지 않는다. 값이 비밀이 아니므로 저장소에 올린다.

VITE_FIREBASE_API_KEY=unit-test-fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-checky.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-checky
VITE_FIREBASE_STORAGE_BUCKET=demo-checky.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=unit-test-fake-app-id
VITE_ADMIN_SHORTCUT_TAP_COUNT=
